        <button class="scenario-btn" data-scen-id="1587" data-era="unification">
          <span class="scen-badge">1587年</span>
          <strong class="scen-title">秀吉の九州征伐</strong>
          <span class="scen-sub">島津vs豊臣</span>
        </button>
        <button class="scenario-btn" data-scen-id="1590" data-era="unification">
          <span class="scen-badge">1590年</span>
          <strong class="scen-title">小田原征伐</strong>
          <span class="scen-sub">天下統一</span>
        </button>
        <button class="scenario-btn" data-scen-id="1592" data-era="unification">
          <span class="scen-badge">1592年</span>
          <strong class="scen-title">文禄の役</strong>
          <span class="scen-sub">名護屋集結</span>
        </button>
        <button class="scenario-btn" data-scen-id="1600" data-era="unification">
          <span class="scen-badge">1600年</span>
          <strong class="scen-title">関ヶ原の戦い</strong>
          <span class="scen-sub">天下分け目</span>
        </button>
        <button class="scenario-btn" data-scen-id="1614" data-era="unification">
          <span class="scen-badge">1614年</span>
          <strong class="scen-title">大坂の陣</strong>
          <span class="scen-sub">真田丸咆哮</span>
