<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <!-- スマホの幅に合わせ、ホームインジケータ分の余白（safe-area）も使えるようにする -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>戦国天下統一伝 〜群雄割拠の覇道〜</title>

  <!-- 外部CDNライブラリ群 -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
  <script src="https://unpkg.com/@popperjs/core@2"></script>
  <script src="https://unpkg.com/tippy.js@6"></script>

  <!-- モジュール化されたCSSスタイルシート (1080p最適化・和風デザイン) -->
  <link rel="stylesheet" href="css/style.css">
</head>
<body>


<div id="game-container">
  <!-- ヘッダー (高さ約42px・シンプル洗練) -->
  <header>
    <div class="title-group">
      <h1>戦国天下統一伝</h1>
      <span class="season-info" id="seasonDisplay">
        <i data-lucide="calendar" style="width:16px; height:16px;"></i>
        <span>天文20年 (1551) 春</span>
      </span>
      <span class="weather-badge" id="weatherDisplay">🌤️ 天候: 晴天</span>
      <span class="diff-badge-header" id="diffBadgeDisplay" style="color:#f39c12; border-color:#d68910; background:rgba(243, 156, 18, 0.2);">【中級】</span>
      <button class="bgm-badge-header" id="bgmToggleBtn" title="戦国管弦楽 響宴録・全24曲BGM (クリックで響宴録を開く)">
        <span id="bgmTitleBadge">🎵 春・群雄の胎動</span>
      </button>
    </div>

    <!-- スマホのみ表示。操作ボタン群の開閉（PCでは非表示） -->
    <button type="button" id="headerControlsToggle" class="mobile-accordion-btn" aria-expanded="false" aria-controls="headerControls">
      操作メニュー
    </button>

    <!-- スマホのみ。勢力ステータスは初期折りたたみ（PCではボタン自体を出さない） -->
    <button type="button" id="clanBarToggle" class="mobile-accordion-btn" aria-expanded="false" aria-controls="clanBar" title="金・兵糧・兵力などの勢力状況">
      勢力状況
    </button>

    <div class="header-controls" id="headerControls">
      <button class="header-btn" id="openJukeboxBtn" title="菅野よう子風 戦国管弦楽 響宴録 (全24曲BGM・効果音鑑賞)" style="border-color:var(--gold-bright); color:var(--gold-bright); font-weight:bold;">
        <i data-lucide="music" style="width:15px; height:15px;"></i>
        <span>管弦楽</span>
      </button>
      <button class="header-btn" id="factionListModalBtn" title="各大名の支配勢力と外交・同盟関係を確認" style="border-color:var(--gold-bright); color:var(--gold-bright); font-weight:bold;">
        <i data-lucide="shield" style="width:15px; height:15px;"></i>
        <span>勢力一覧</span>
      </button>
      <button class="header-btn" id="provinceListModalBtn" title="全国の領国・城主・石高を確認" style="border-color:var(--gold-bright); color:var(--gold-bright); font-weight:bold;">
        <i data-lucide="landmark" style="width:15px; height:15px;"></i>
        <span>領国一覧</span>
      </button>
      <button class="header-btn" id="officerListModalBtn" title="配下・参陣武将の一覧と列伝を確認" style="border-color:var(--gold-bright); color:var(--gold-bright); font-weight:bold;">
        <i data-lucide="users" style="width:15px; height:15px;"></i>
        <span>武将一覧</span>
      </button>
      <button class="header-btn" id="governModalBtn" title="複数の国をまとめて委任統治" style="border-color:var(--gold-bright); color:var(--gold-bright); font-weight:bold;">
        <i data-lucide="briefcase" style="width:15px; height:15px;"></i>
        <span>領国一括委任</span>
      </button>
      <button class="header-btn" id="saveGameBtn" title="戦況保存">
        <i data-lucide="save" style="width:15px; height:15px;"></i>
        <span>記録</span>
      </button>
      <button class="header-btn" id="loadGameBtn" title="戦況読込">
        <i data-lucide="folder-open" style="width:15px; height:15px;"></i>
        <span>読込</span>
      </button>
      <button class="sound-btn" id="soundToggleBtn">
        <span id="soundIcon">🔊</span> <span id="soundText">音: ON</span>
      </button>
      <input type="range" class="volume-slider" id="volumeSlider" min="0" max="1" step="0.05" value="0.75" title="主音量">
    </div>
  </header>

  <!-- 反覇道包囲網警報バナー -->
  <div class="coalition-banner" id="coalitionBanner">
    ⚠【反覇道包囲網 結成】諸大名が同盟を結び、貴家打倒に立ち上がりました！前線各城の防備を固めてください！
  </div>

  <!-- 戦況年代記（幅広バー：一つ下のボックス上端・覇道進捗の上・クリックで全年代記モーダル展開） -->
  <div class="chronicle-wide-bar" id="headerChronicleWrap" title="クリックで全年代記記録を展開">
    <div class="chronicle-bar-label" id="openChronicleBtn">
      <i data-lucide="scroll" style="width:16px; height:16px;"></i>
      <span>戦況年代記</span>
      <i data-lucide="chevron-down" style="width:13px; height:13px; opacity:0.8;"></i>
    </div>
    <div class="chronicle-bar-box" id="gameLog">
      <div class="log-entry important">戦国乱世の幕が開きました。当主を選択して覇道を開始してください。</div>
    </div>
    <div class="chronicle-bar-hint">
      <span>📜 全記録一覧</span>
    </div>
  </div>

  <!-- 勢力ステータスバー (高さ約46px・7分割・武将省略) -->
  <div class="clan-bar" id="clanBar">
    <div class="stat-card" style="display:flex; flex-direction:row; align-items:center; gap:8px; overflow:hidden; padding:2px 6px;">
      <svg id="headerKamonSvg" width="34" height="34" viewBox="0 0 32 32" style="border-radius:50%; box-shadow:0 0 6px rgba(212,175,55,0.5); flex-shrink:0;">
        <circle cx="16" cy="16" r="15" fill="#d4ac0d" stroke="#ffd700" stroke-width="2"/>
        <text x="16" y="21" font-family="'Yu Mincho', serif" font-size="15" font-weight="bold" fill="#fff" text-anchor="middle">長</text>
      </svg>
      <div style="flex:1; min-width:0; display:flex; flex-direction:column; justify-content:center; gap:1px;">
        <div style="display:flex; align-items:center; justify-content:space-between; line-height:1.15;">
          <span id="statDaimyo" style="font-size:12.5pt; font-weight:bold; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">長宗我部元親</span>
          <span id="statPersonalityBadge" style="font-size:11pt; padding:1px 5px; border-radius:3px; background:rgba(52,152,219,0.18); color:#88ccff; border:1px solid rgba(52,152,219,0.4); white-space:nowrap;">バランス型</span>
        </div>
        <div style="display:flex; align-items:center; justify-content:space-between; line-height:1.15;">
          <span id="statClan" style="font-size:11.5pt; color:var(--gold-bright); font-weight:bold; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">長宗我部家</span>
          <span id="statAbilities" style="font-size:11.5pt; color:#e0e0e0; white-space:nowrap; font-family:sans-serif;">
            <span style="color:#ff8888; font-weight:bold;">武<span id="statMil">88</span></span>
            <span style="color:#88ff88; font-weight:bold; margin-left:5px;">内<span id="statPol">84</span></span>
            <span style="color:#88ccff; font-weight:bold; margin-left:5px;">謀<span id="statStrat">86</span></span>
          </span>
        </div>
      </div>
    </div>
    <div class="stat-card" id="probCard" style="border-color: #d4af37;">
      <span class="label"><i data-lucide="target" style="width:13px; height:13px;"></i> 覇道進捗</span>
      <span class="value" id="statProbability" style="color:#ffd700;">20%</span>
      <div class="prob-bar-track" style="margin-top:1px; height:4px;">
        <div class="prob-bar-fill" id="statProbBar" style="width: 20%;"></div>
      </div>
      <span class="sub-value" id="statProbDesc">天下統一確率 二割</span>
    </div>
    <div class="stat-card">
      <span class="label"><i data-lucide="map" style="width:13px; height:13px;"></i> 支配領国</span>
      <span class="value" id="statProvinces" style="color:#fff;">1 / 50 国</span>
      <span class="sub-value" id="statProgression">天下統一まで 49国</span>
    </div>
    <div class="stat-card ap-highlight">
      <span class="label"><i data-lucide="scroll" style="width:13px; height:13px;"></i> 軍令権 (行動力)</span>
      <span class="value" id="statAp" style="color:var(--gold-bright);">3 / 3</span>
      <div class="ap-tokens-wrap" id="apTokensContainer" style="margin-top:1px;"></div>
    </div>
    <div class="stat-card">
      <span class="label"><i data-lucide="coins" style="width:13px; height:13px;"></i> 備蓄金 (貫)</span>
      <span class="value" id="statGold" style="color:#ffd700;">400</span>
      <span class="sub-value">夏・冬に商業運上</span>
    </div>
    <div class="stat-card">
      <span class="label"><i data-lucide="wheat" style="width:13px; height:13px;"></i> 兵糧米 (石)</span>
      <span class="value" id="statRice" style="color:#ffcc66;">600</span>
      <span class="sub-value">秋に収穫 / 毎季消費</span>
    </div>
    <div class="stat-card">
      <span class="label"><i data-lucide="swords" style="width:13px; height:13px;"></i> 総動員兵力</span>
      <span class="value" id="statTroops" style="color:#ff8888;">5,000</span>
      <span class="sub-value">全領地駐留総数</span>
    </div>
  </div>

  <!-- メイン画面：精緻な50か国SVGマップ ＋ 指揮卓 (24インチ1画面収容) -->
  <div class="main-layout">
    <!-- 50か国精緻SVG日本地図 (国名・兵力テキスト非表示、家紋バッジのみ配置) -->
    <div class="map-wrapper" id="mapWrapper">
      <div class="map-controls-group">
        <button class="map-ctrl-btn" id="mapZoomInBtn" title="拡大 (ホイール上)">＋</button>
        <button class="map-ctrl-btn" id="mapZoomOutBtn" title="縮小 (ホイール下)">−</button>
        <button class="map-ctrl-btn" id="mapResetBtn" title="全体表示リセット">⟲</button>
      </div>
      <svg id="sengokuMapSvg" viewBox="17 90 966 500" class="sengoku-svg-map">
        
<defs>
  <symbol id="kamon-abe" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#515a5a" stroke="#ffd700" stroke-width="1.5"/>
    <path d="M11 12 C9 10 13 8 16 11 C14 13 12 14 11 12 Z" fill="#ffffff"/>
    <circle cx="10" cy="11" r="1" fill="#ffd700"/>
    <path d="M17 19 C15 17 19 15 22 18 C20 20 18 21 17 19 Z" fill="#ffffff"/>
    <circle cx="16" cy="18" r="1" fill="#ffd700"/>
  </symbol>
  <symbol id="kamon-aizu" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#17202a" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="12" fill="none" stroke="#ffd700" stroke-width="1.8"/>
    <!-- 三つ葵 -->
    <path d="M 16 15 C 13.5 11.5 12 9 16 7 C 20 9 18.5 11.5 16 15 Z" fill="#ffd700"/>
    <path d="M 15.5 16.5 C 12 17.5 9 19.5 10.5 23.5 C 13.5 23.5 15 20 15.5 16.5 Z" fill="#ffd700"/>
    <path d="M 16.5 16.5 C 20 17.5 23 19.5 21.5 23.5 C 18.5 23.5 17 20 16.5 16.5 Z" fill="#ffd700"/>
    <circle cx="16" cy="16" r="1.5" fill="#ffffff"/>
  </symbol>
  <symbol id="kamon-akamatsu" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#881e1e" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="11.8" fill="none" stroke="#ffd700" stroke-width="1.2"/>
    <circle cx="16" cy="10.2" r="3.6" fill="#ffffff"/>
    <path d="M 16 6.6 C 21.5 6.6 23.5 13.5 22 17 C 20.8 19.5 18 19 16 16 C 18 13 17 9 16 6.6 Z" fill="#ffffff"/>
    <circle cx="21" cy="18.9" r="3.6" fill="#ffffff"/>
    <path d="M 24.1 20.7 C 21.4 25.5 14.3 25.4 11.2 23.2 C 9 21.3 10.2 18.5 16 16 C 16 19.5 19.5 20.5 24.1 20.7 Z" fill="#ffffff"/>
    <circle cx="11" cy="18.9" r="3.6" fill="#ffffff"/>
    <path d="M 7.9 20.7 C 5.1 15.9 10.2 9.1 14.8 7.8 C 18.2 6.8 19.8 10.5 16 16 C 14 15.5 11.5 18 7.9 20.7 Z" fill="#ffffff"/>
    <circle cx="16" cy="16" r="1.8" fill="#881e1e"/>
  </symbol>
  <symbol id="kamon-anekoji" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#239b56" stroke="#ffd700" stroke-width="1.5"/>
    <path d="M16 5.5 L19.2 12.2 L26.5 13 L21 18.1 L22.5 25.3 L16 21.7 L9.5 25.3 L11 18.1 L5.5 13 L12.8 12.2 Z" fill="#ffffff"/>
    <circle cx="16" cy="15.2" r="3.2" fill="#239b56" stroke="#ffd700" stroke-width="0.8"/>
  </symbol>
  <symbol id="kamon-hatano" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#7d3c98" stroke="#ffd700" stroke-width="1.5"/>
    <rect x="9" y="8" width="14" height="16" rx="1.5" fill="none" stroke="#ffffff" stroke-width="1.6"/>
    <path d="M11 12 H21 M11 16 H21 M11 20 H21" stroke="#ffd700" stroke-width="1.4"/>
    <circle cx="16" cy="16" r="2.4" fill="#ffffff"/>
  </symbol>
  <symbol id="kamon-amago" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#21618c" stroke="#ffd700" stroke-width="1.5"/>
    <rect x="9" y="9" width="6" height="6" fill="#ffffff"/><rect x="11" y="11" width="2" height="2" fill="#21618c"/><rect x="17" y="9" width="6" height="6" fill="#ffffff"/><rect x="19" y="11" width="2" height="2" fill="#21618c"/><rect x="9" y="17" width="6" height="6" fill="#ffffff"/><rect x="11" y="19" width="2" height="2" fill="#21618c"/><rect x="17" y="17" width="6" height="6" fill="#ffffff"/><rect x="19" y="19" width="2" height="2" fill="#21618c"/>
  </symbol>
  <symbol id="kamon-ando" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#1f618d" stroke="#ffd700" stroke-width="1.5"/>
    <path d="M8,22 Q16,8 24,22 L16,24 Z" fill="#ffd700"/><line x1="16" y1="24" x2="11" y2="12" stroke="#1f618d" stroke-width="1.2"/><line x1="16" y1="24" x2="16" y2="10" stroke="#1f618d" stroke-width="1.2"/><line x1="16" y1="24" x2="21" y2="12" stroke="#1f618d" stroke-width="1.2"/>
  </symbol>
  <symbol id="kamon-arima" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#1b2631" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="4.5" fill="#ffd700"/><line x1="16" y1="6" x2="16" y2="26" stroke="#ffffff" stroke-width="2.2"/><line x1="6" y1="16" x2="26" y2="16" stroke="#ffffff" stroke-width="2.2"/><line x1="9" y1="9" x2="23" y2="23" stroke="#ffffff" stroke-width="2.2"/><line x1="9" y1="23" x2="23" y2="9" stroke="#ffffff" stroke-width="2.2"/>
  </symbol>
  <symbol id="kamon-asakura" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#5b2c6f" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="11" r="4.5" fill="none" stroke="#ffffff" stroke-width="1.6"/><circle cx="11" cy="20" r="4.5" fill="none" stroke="#ffffff" stroke-width="1.6"/><circle cx="21" cy="20" r="4.5" fill="none" stroke="#ffffff" stroke-width="1.6"/><circle cx="16" cy="16" r="2.2" fill="#ffd700"/>
  </symbol>
  <symbol id="kamon-asano" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#6c3483" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="12" fill="none" stroke="#ffd700" stroke-width="1.6"/>
    <polygon points="12,7 19,25 16,25 10,9" fill="#ffffff"/>
    <polygon points="20,7 13,25 16,25 22,9" fill="#ffffff"/>
  </symbol>
  <symbol id="kamon-ashikaga" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#1b2631" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="12" fill="none" stroke="#ffd700" stroke-width="2"/>
    <line x1="6" y1="12" x2="26" y2="12" stroke="#ffffff" stroke-width="3.2"/>
    <line x1="6" y1="20" x2="26" y2="20" stroke="#ffffff" stroke-width="3.2"/>
  </symbol>
  <symbol id="kamon-ashina" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#6e2c00" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="11" fill="none" stroke="#ffffff" stroke-width="1.8"/><line x1="7" y1="11" x2="25" y2="11" stroke="#ffffff" stroke-width="2.2"/><line x1="6" y1="16" x2="26" y2="16" stroke="#ffffff" stroke-width="2.2"/><line x1="7" y1="21" x2="25" y2="21" stroke="#ffffff" stroke-width="2.2"/>
  </symbol>
  <symbol id="kamon-azai" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#1e8449" stroke="#ffd700" stroke-width="1.5"/>
    <polygon points="16,6 20,8.5 20,13.5 16,16 12,13.5 12,8.5" fill="none" stroke="#ffffff" stroke-width="1.5"/><polygon points="10,15 14,17.5 14,22.5 10,25 6,22.5 6,17.5" fill="none" stroke="#ffffff" stroke-width="1.5"/><polygon points="22,15 26,17.5 26,22.5 22,25 18,22.5 18,17.5" fill="none" stroke="#ffffff" stroke-width="1.5"/>
  </symbol>
  <symbol id="kamon-chiba" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#1b2631" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="11" fill="none" stroke="#ffd700" stroke-width="1.6"/><path d="M12,10 A6,6 0 0,0 20,18 A7,7 0 0,1 12,10 Z" fill="#ffffff"/><circle cx="21" cy="11" r="2.2" fill="#ffd700"/>
  </symbol>
  <symbol id="kamon-chosokabe" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#d4ac0d" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="3" fill="#ffffff"/><circle cx="16" cy="7.5" r="2.8" fill="#ffffff"/><circle cx="23.5" cy="11" r="2.8" fill="#ffffff"/><circle cx="24" cy="19.5" r="2.8" fill="#ffffff"/><circle cx="18" cy="24.5" r="2.8" fill="#ffffff"/><circle cx="11" cy="23" r="2.8" fill="#ffffff"/><circle cx="8" cy="15.5" r="2.8" fill="#ffffff"/><circle cx="11" cy="9.5" r="2.8" fill="#ffffff"/><polygon points="16,11 15,14 17,14" fill="#ffffff"/><polygon points="20,13 18,15 19,17" fill="#ffffff"/><polygon points="20,19 18,18 19,16" fill="#ffffff"/><polygon points="16,21 17,18 15,18" fill="#ffffff"/><polygon points="12,19 14,18 13,16" fill="#ffffff"/><polygon points="12,13 14,15 13,17" fill="#ffffff"/>
  </symbol>
  <symbol id="kamon-date" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#8e44ad" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="11.5" fill="none" stroke="#ffffff" stroke-width="1.4"/><ellipse cx="16" cy="8.5" rx="2.5" ry="4" fill="#ffffff"/><ellipse cx="16" cy="23.5" rx="2.5" ry="4" fill="#ffffff"/><ellipse cx="8.5" cy="16" rx="4" ry="2.5" fill="#ffffff"/><ellipse cx="23.5" cy="16" rx="4" ry="2.5" fill="#ffffff"/><circle cx="16" cy="16" r="2.5" fill="#ffd700"/>
  </symbol>
  <symbol id="kamon-default" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#2c3e50" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="11" fill="none" stroke="#ffffff" stroke-width="1.8"/><polygon points="16,8 24,16 16,24 8,16" fill="#ffd700"/>
  </symbol>
  <symbol id="kamon-ezo" viewBox="0 0 32 32">
    <circle cx="16" cy="16" r="15" fill="#1b2631" stroke="#5dade2" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="12" fill="none" stroke="#ffffff" stroke-width="1.2"/>
    <path d="M16 9 C12 9 9 12 9 16 C9 20 12 23 16 23 C20 23 23 20 23 16 C23 13 21 11 18 11 C15 11 13 13 13 16 C13 18 14.5 19.5 16 19.5" fill="none" stroke="#5dade2" stroke-width="2" stroke-linecap="round"/>
  </symbol>
  <symbol id="kamon-fujiwara" viewBox="0 0 32 32">
