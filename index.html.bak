    </button>
  </div>
</div>

<!-- 大名詳細・歴史情勢＆戦略解説図ダイアログ -->
<div class="daimyo-popup-overlay hidden" id="daimyoPopup">
  <div class="daimyo-popup-card">
    <button class="daimyo-popup-close-btn" id="daimyoPopupCloseBtn" title="閉じる">✕</button>

    <!-- ヘッダー (家紋・大名名・シナリオ名・難易度・領国数) -->
    <div class="daimyo-popup-header">
      <svg id="popupKamonSvg" viewBox="0 0 32 32"><use id="popupKamonUse" href="#kamon-oda"></use></svg>
      <div>
        <div style="display:flex; align-items:center; gap:10px;">
          <h2 id="popupDaimyoName" style="margin:0;">織田信長</h2>
          <span class="clan-label" id="popupClanName" style="font-size:13pt; color:var(--gold-bright); font-weight:bold;">織田家</span>
        </div>
        <div id="popupScenarioContext" style="font-size:12pt; color:#e59866; margin-top:2px;">❖ 1560年 桶狭間の戦い ❖</div>
      </div>
      <div style="margin-left:auto; text-align:right;">
        <span id="popupDifficulty" style="font-size:12pt; border:1px solid #ff9999; padding:2px 10px; border-radius:3px; color:#ff9999; font-weight:bold;">上級</span>
        <div id="popupProvCount" style="font-size:12pt; color:var(--gold); margin-top:4px;">支配: 1国</div>
      </div>
    </div>

    <!-- 能力値 & 初期資源バー (5列均等) -->
    <div style="display:grid; grid-template-columns:repeat(5, 1fr); gap:8px; margin-bottom:12px;">
      <div class="daimyo-popup-stat">
        <span class="label">⚔️ 武勇</span>
        <span class="val" id="popupMilitary" style="color:#ff8888;">85</span>
      </div>
      <div class="daimyo-popup-stat">
        <span class="label">🌾 内政</span>
        <span class="val" id="popupPolitics" style="color:#88ff88;">70</span>
      </div>
      <div class="daimyo-popup-stat">
        <span class="label">🧠 調略</span>
        <span class="val" id="popupStratagem" style="color:#8888ff;">80</span>
      </div>
      <div class="daimyo-popup-stat">
        <span class="label">💰 初期資金</span>
        <span class="val" id="popupGold" style="color:#ffd700; font-size:13pt;">400 貫</span>
      </div>
      <div class="daimyo-popup-stat">
        <span class="label">🌾 初期兵糧</span>
        <span class="val" id="popupRice" style="color:#ffcc66; font-size:13pt;">600 石</span>
      </div>
    </div>

    <!-- 統治気質 & 奥義バナー -->
    <div style="display:flex; gap:10px; margin-bottom:12px; align-items:center;">
      <div id="popupPersonality" style="flex-shrink:0;"></div>
      <div class="daimyo-popup-tactic" id="popupTactic" style="margin:0; flex:1; padding:6px 12px;">
        <strong>⚡ 奥義「天下布武」</strong> 全軍の士気を大幅に高め、一斉攻撃を行う！
      </div>
    </div>

    <!-- メインコンテンツ 2段グリッド (左: 歴史的位置づけと情勢 / 右: 戦略解説図) -->
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; margin-bottom:14px;">
      <!-- 左列: 歴史的位置づけ & 周辺の出来事 -->
      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="background:rgba(0,0,0,0.4); border:1px solid #553e2a; border-radius:6px; padding:10px 12px;">
          <div style="font-size:12pt; font-weight:bold; color:var(--gold-bright); margin-bottom:6px; display:flex; align-items:center; gap:6px;">
            📜 <span>【シナリオにおける位置づけ】</span>
          </div>
          <div class="daimyo-popup-desc" id="popupDesc" style="margin:0; padding:0; background:none; border:none; line-height:1.6;">
            <!-- 動的挿入 -->
          </div>
        </div>

        <div style="background:rgba(0,0,0,0.4); border:1px solid #553e2a; border-radius:6px; padding:10px 12px; flex:1;">
          <div style="font-size:12pt; font-weight:bold; color:#ff9999; margin-bottom:6px; display:flex; align-items:center; gap:6px;">
            ⚔️ <span>【周りの出来事・近隣勢力動向】</span>
          </div>
          <div id="popupSurroundingEvents" style="font-size:12pt; color:#ddd; line-height:1.6;">
            <!-- 動的挿入 -->
          </div>
        </div>
      </div>

      <!-- 右列: 戦略解説図 (ビジュアルダイヤグラム & 初手攻略手引き) -->
      <div style="background:rgba(14,10,7,0.7); border:1px solid var(--border-gold); border-radius:6px; padding:10px 12px; display:flex; flex-direction:column;">
        <div style="font-size:12pt; font-weight:bold; color:var(--gold-bright); margin-bottom:6px; display:flex; justify-content:space-between; align-items:center;">
          <span>🗺️ 【戦略解説図・勢力相関図】</span>
          <span style="font-size:12pt; color:#aaa;" id="popupHomeCastleName">尾張・清洲城</span>
        </div>
        <!-- 解説図 SVG コンテナ -->
        <div id="popupStrategyDiagram" style="flex:1; min-height:180px; background:#120c08; border:1px solid #443020; border-radius:4px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center;">
          <!-- SVGをJSで動的描画 -->
        </div>
        <!-- 攻略方針ガイダンス -->
        <div id="popupStrategyAdvice" style="margin-top:8px; background:rgba(0,0,0,0.5); padding:6px 10px; border-radius:4px; border-left:3px solid #2ecc71; font-size:12pt; line-height:1.5; color:#a9dfbf;">
          <!-- 動的挿入 -->
        </div>
      </div>
    </div>

    <!-- アクションボタン群 (大名で出陣スタートボタン ＋ 別の大名を選び直すボタン) -->
    <div style="display:flex; gap:12px; justify-content:center; align-items:center; padding-top:6px; border-top:1px solid rgba(212,175,55,0.3);">
      <button class="daimyo-popup-cancel-btn" id="daimyoPopupCancelBtn" style="min-width:200px;">
        ↩️ 別の大名を選び直す
      </button>
      <button class="daimyo-popup-start-btn" id="daimyoPopupStartBtn" style="flex:1; max-width:480px; margin:0; padding:12px 24px; font-size:13.5pt;">
        ⚔️ この大名で天下統一へ出陣！
      </button>
    </div>
  </div>
</div>

<!-- 全戦況年代記モーダル (ヘッダー年代記クリックで展開) -->
<div class="modal-overlay hidden" id="chronicleModal">
  <div class="modal-card" style="max-width: 820px; max-height: 85vh; display: flex; flex-direction: column;">
    <div class="modal-title" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--gold); padding-bottom: 8px;">
      <span style="display:flex; align-items:center; gap:8px;">
        <i data-lucide="scroll" style="width:20px; height:20px; color:var(--gold-bright);"></i>
        <span>戦況年代記・全軍事内政記録</span>
      </span>
      <button id="closeChronicleModalBtn" style="background:none; border:none; color:#aaa; font-size:18pt; cursor:pointer; line-height:1;">✕</button>
    </div>
    <div class="chronicle-modal-list" id="chronicleFullList" style="flex: 1; overflow-y: auto; padding: 14px 18px; font-size: 12pt; line-height: 1.8; background: rgba(0,0,0,0.5); border: 1px solid #4a3828; border-radius: 6px; margin: 14px 0; max-height: 60vh;">
      <div class="log-entry important">戦国乱世の幕が開きました。当主を選択して覇道を開始してください。</div>
    </div>
    <div style="display: flex; justify-content: flex-end;">
      <button class="turn-btn" id="closeChronicleModalBtn2" style="width: auto; padding: 8px 24px; font-size: 12pt; margin: 0;">
        閉じる
      </button>
    </div>
  </div>
</div>

<!-- 戦国管弦楽 響宴録 モーダル (全24曲BGM・オーケストラ効果音鑑賞＆調律) -->
<div class="modal-overlay hidden" id="musicJukeboxModal" style="z-index: 10000;">
  <div class="modal-card" style="max-width: 960px; max-height: 90vh; display: flex; flex-direction: column; background: linear-gradient(180deg, #24160f 0%, #150d09 100%); border: 2px solid var(--gold); box-shadow: 0 10px 40px rgba(0,0,0,0.95), 0 0 30px rgba(212,175,55,0.3);">
    <!-- モーダルヘッダー -->
    <div class="modal-title" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid var(--gold); padding-bottom: 8px;">
      <span style="display:flex; align-items:center; gap:10px;">
        <span style="font-size:18pt;">🎻</span>
        <span style="font-size:14pt; font-weight:bold; color:var(--gold-bright); letter-spacing:1px;">戦国管弦楽 響宴録 〜菅野よう子風 交響詩鑑賞＆音響調律〜</span>
      </span>
      <button id="closeJukeboxBtn" style="background:none; border:none; color:#aaa; font-size:18pt; cursor:pointer; line-height:1;" title="閉じる">✕</button>
    </div>

    <!-- モーダルコンテンツ (スクロール可) -->
    <div style="flex: 1; overflow-y: auto; padding: 12px 16px; display: flex; flex-direction: column; gap: 14px;">

      <!-- 現在演奏中の曲 プレーヤーステーション -->
      <div class="jukebox-player-card" style="background: rgba(0,0,0,0.6); border: 1px solid var(--gold); border-radius: 8px; padding: 14px 18px; display: flex; flex-direction: column; gap: 10px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10px;">
          <div>
            <div style="font-size: 10pt; color: var(--gold); letter-spacing: 2px; font-weight: bold;">NOW PLAYING 演奏中</div>
            <div id="jbTrackTitle" style="font-size: 16pt; font-weight: bold; color: #fff; text-shadow: 0 0 10px rgba(255,215,0,0.6); margin-top: 2px;">天下創世・群雄割拠</div>
            <div id="jbTrackGenre" style="font-size: 11pt; color: #e5dac9; margin-top: 2px;">大序曲・フルオーケストラ行進曲</div>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <!-- イコライザーバーアニメーション -->
            <div class="jb-eq-visualizer" id="jbEqVisualizer">
              <span class="jb-eq-bar"></span>
              <span class="jb-eq-bar"></span>
              <span class="jb-eq-bar"></span>
              <span class="jb-eq-bar"></span>
              <span class="jb-eq-bar"></span>
            </div>
            <!-- コントロールボタン -->
            <button class="jb-btn" id="jbPrevBtn" title="前の曲">⏮ 前曲</button>
            <button class="jb-btn primary" id="jbPlayPauseBtn" title="再生・一時停止">⏸ 停止</button>
            <button class="jb-btn" id="jbNextBtn" title="次の曲">⏭ 次曲</button>
          </div>
        </div>

        <div id="jbTrackDesc" style="font-size: 11pt; color: #ded6c8; line-height: 1.6; background: rgba(255,255,255,0.04); padding: 8px 12px; border-radius: 5px; border-left: 3px solid var(--gold);">
          菅野よう子サウンドの真骨頂。勇壮な金管ファンファーレと流麗な和琴、ティンパニが轟く乱世開幕の大序曲。
        </div>

        <!-- 音量・設定コントロールバー -->
        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding-top: 6px; border-top: 1px solid rgba(212,175,55,0.25);">
          <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
            <label style="display: flex; align-items: center; gap: 6px; font-size: 11pt; color: #f5eedc;">
              <span>主音量:</span>
              <input type="range" id="jbMasterVol" min="0" max="1" step="0.05" value="0.75" style="width: 80px;">
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 11pt; color: #f5eedc;">
              <span>BGM:</span>
              <input type="range" id="jbBgmVol" min="0" max="1" step="0.05" value="0.60" style="width: 80px;">
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 11pt; color: #f5eedc;">
              <span>効果音:</span>
              <input type="range" id="jbSeVol" min="0" max="1" step="0.05" value="0.85" style="width: 80px;">
            </label>
          </div>
          <label style="display: flex; align-items: center; gap: 6px; font-size: 11pt; color: var(--gold-bright); cursor: pointer;">
            <input type="checkbox" id="jbDaimyoModeCheck" checked style="cursor: pointer; width: 16px; height: 16px;">
            <span>大名家専用BGM 優先再生 (織田/武田/上杉/伊達/西国/島津/北条)</span>
          </label>
        </div>
      </div>

      <!-- 楽曲選曲リスト (4大カテゴリ・全24曲) -->
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <div style="font-size: 13pt; font-weight: bold; color: var(--gold-bright); border-bottom: 1px solid var(--border-gold); padding-bottom: 4px; display:flex; justify-content:space-between; align-items:center;">
          <span>🎼 全24曲 和洋折衷フルオーケストラ楽曲録</span>
          <span style="font-size: 10pt; color: #aaa;">クリックで即座に試聴・ゲーム中BGM設定</span>
        </div>
        <div id="jbTrackListContainer" style="display: flex; flex-direction: column; gap: 12px; max-height: 38vh; overflow-y: auto; padding-right: 4px;">
          <!-- カテゴリごとにJSで生成 -->
        </div>
      </div>

      <!-- 珠玉のオーケストラ効果音 (SE) 試聴ボード -->
      <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 4px;">
        <div style="font-size: 13pt; font-weight: bold; color: var(--gold-bright); border-bottom: 1px solid var(--border-gold); padding-bottom: 4px;">
          🥁 珠玉のオーケストラ＆戦国効果音 (SE) 試聴
        </div>
        <div class="jb-se-grid" id="jbSeGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px;">
          <!-- SEボタン群 -->
        </div>
      </div>

    </div>

    <!-- モーダルフッター -->
    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(212,175,55,0.3); padding-top: 10px; margin-top: 6px;">
      <div style="font-size: 10pt; color: #999;">
        ※ Web Audio API シンセサイザーによるリアルタイム合成交響楽です。外部音声ファイルの読み込み待機なく即座に鳴り響きます。
      </div>
      <button class="turn-btn" id="closeJukeboxBtn2" style="width: auto; padding: 6px 20px; font-size: 11pt; margin: 0;">
        閉じる
      </button>
    </div>
  </div>
</div>


  <!-- モジュール化されたJavaScript群 (順序保証ロード) -->
  <!-- 1. 全135大名家・全53シナリオ・全76領国データベース -->
  <script src="js/data.js"></script>
  <script src="js/data_officers.js"></script>
  
  <!-- 2. 菅野よう子風 洗練和風交響BGMエンジン (全15曲) -->
  <script src="js/bgm.js"></script>

  <!-- 3. 戦国天下統一伝 ゲームエンジン本体 -->
  <script src="js/app.js"></script>

</body>
</html>
