        <button class="scenario-btn" data-scen-id="1637" data-era="edo_bakumatsu">
          <span class="scen-badge">1637年</span>
          <strong class="scen-title">島原の乱</strong>
          <span class="scen-sub">天草四郎</span>
        </button>
        <button class="scenario-btn" data-scen-id="1651" data-era="edo_bakumatsu">
          <span class="scen-badge">1651年</span>
          <strong class="scen-title">慶安の変</strong>
          <span class="scen-sub">由比正雪</span>
        </button>
        <button class="scenario-btn" data-scen-id="1702" data-era="edo_bakumatsu">
          <span class="scen-badge">1702年</span>
          <strong class="scen-title">赤穂浪士討ち入り</strong>
          <span class="scen-sub">大石内蔵助</span>
        </button>
        <button class="scenario-btn" data-scen-id="1721" data-era="edo_bakumatsu">
          <span class="scen-badge">1721年</span>
          <strong class="scen-title">享保の改革</strong>
          <span class="scen-sub">徳川吉宗</span>
        </button>
        <button class="scenario-btn" data-scen-id="1789" data-era="edo_bakumatsu">
          <span class="scen-badge">1789年</span>
          <strong class="scen-title">寛政の改革</strong>
          <span class="scen-sub">松平定信</span>
        </button>
        <button class="scenario-btn" data-scen-id="1837" data-era="edo_bakumatsu">
          <span class="scen-badge">1837年</span>
          <strong class="scen-title">大塩平八郎の乱</strong>
          <span class="scen-sub">大坂蜂起</span>
        </button>
        <button class="scenario-btn" data-scen-id="1853" data-era="edo_bakumatsu">
          <span class="scen-badge">1853年</span>
          <strong class="scen-title">ペリー来航</strong>
          <span class="scen-sub">黒船浦賀</span>
        </button>
        <button class="scenario-btn" data-scen-id="1860" data-era="edo_bakumatsu">
          <span class="scen-badge">1860年</span>
          <strong class="scen-title">桜田門外の変</strong>
          <span class="scen-sub">井伊直弼</span>
        </button>
        <button class="scenario-btn" data-scen-id="1866" data-era="edo_bakumatsu">
          <span class="scen-badge">1866年</span>
          <strong class="scen-title">薩長同盟</strong>
          <span class="scen-sub">龍馬奔走</span>
        </button>
        <button class="scenario-btn" data-scen-id="1868" data-era="edo_bakumatsu">
          <span class="scen-badge">1868年</span>
          <strong class="scen-title">戊辰戦争</strong>
          <span class="scen-sub">維新胎動</span>
        </button>
        <button class="scenario-btn" data-scen-id="1877" data-era="edo_bakumatsu">
          <span class="scen-badge">1877年</span>
          <strong class="scen-title">西南戦争</strong>
          <span class="scen-sub">西郷挙兵</span>
        </button>
        </div>
      </div>
    

    <!-- シナリオ詳細解説ボックス -->
      <div class="scenario-desc-box" id="scenarioDescBox" style="background:rgba(20,14,10,0.95); border:1px solid var(--border-gold); border-radius:4px; padding:10px 16px; margin-top:6px; margin-bottom: 6px; font-size: 12pt; line-height:1.35;">
        <!-- JSで動的生成 -->
      </div>
    </div>

    <!-- 難易度選択 (上下圧縮・1行配置) -->
    <div style="background:rgba(0,0,0,0.4); border:1px solid #553e2a; border-radius:4px; padding:4px 12px; margin: 6px 0 12px 0; display:flex; align-items:center; gap:12px;">
      <span style="font-size: 12pt; font-weight:bold; color:var(--gold-bright); flex-shrink:0;">⚙️ 難易度:</span>
      <div class="diff-selector-group" style="flex:1; display:grid; grid-template-columns:repeat(4, 1fr); gap:6px;">
        <button class="diff-option-btn" data-diff="easy" style="padding:2px 8px; font-size:12pt;">
          【初級】天下泰平 <span style="color:#aaa; font-size:12pt;">(金800/米1200)</span>
        </button>
        <button class="diff-option-btn selected" data-diff="normal" style="padding:2px 8px; font-size:12pt;">
          【中級】群雄割拠 <span style="color:#aaa; font-size:12pt;">(金500/米800)</span>
        </button>
        <button class="diff-option-btn" data-diff="hard" style="padding:2px 8px; font-size:12pt;">
          【上級】風雲再起 <span style="color:#aaa; font-size:12pt;">(金350/米500)</span>
        </button>
        <button class="diff-option-btn" data-diff="hell" style="padding:2px 8px; font-size:12pt;">
          【修羅】戦国地獄 <span style="color:#ff9999; font-size:12pt;">(包囲網)</span>
        </button>
      </div>
    </div>

    <!-- 大名選択グリッド -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin:6px 0 4px 0;">
      <div style="font-size: 12pt; font-weight:bold; color:var(--gold-bright);">
        🏯 選択可能大名一覧 (各大名をクリックすると歴史情勢・戦略解説図が表示され出陣できます)
      </div>
      <div id="selectedDaimyoBadge" style="font-size: 12pt; color:#ffd700; background:rgba(0,0,0,0.6); padding:4px 12px; border-radius:3px; border:1px solid #d4af37;">
        大名をクリックして出陣へ
      </div>
    </div>
    <div class="daimyo-grid" id="daimyoGrid"></div>
  </div>
</div>

<!-- 2. 領国一括委任モーダル (軍事型、内政型、バランス型、兵站輸送型、直轄) -->
<div class="modal-overlay hidden" id="governModal">
  <div class="modal-card" style="max-width: 820px;">
    <div class="modal-title" style="color:var(--gold-bright); border-bottom-color:var(--gold);">
      📋 領国一括委任（軍団統治・方針設定）
    </div>
    <div style="font-size: 12pt; color:#ddd; margin-bottom:12px; line-height:1.6;">
      支配下の領国に統治方針を設定します。委任された国は季節進行時に方針に従って自動で発展・兵站輸送を行い、プレイヤーの手間を大幅に軽減します。
    </div>

    <!-- 一括設定プリセットボタン -->
    <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:8px; margin-bottom:14px;">
      <button class="diff-option-btn" id="btnPresetDomestic" style="border-color:#27ae60; color:#a9dfbf; padding:8px;">
        🌾 後方を全て内政委任<br><span style="font-size: 12pt; color:#ccc;">商業・石高を自動強化</span>
      </button>
      <button class="diff-option-btn" id="btnPresetLogistics" style="border-color:#3498db; color:#aed6f1; padding:8px;">
        🚚 後方を全て兵站輸送<br><span style="font-size: 12pt; color:#ccc;">前線城へ兵力を自動集結</span>
      </button>
      <button class="diff-option-btn" id="btnPresetMilitary" style="border-color:#e74c3c; color:#ffaaaa; padding:8px;">
        ⚔️ 前線を全て軍事委任<br><span style="font-size: 12pt; color:#ccc;">兵員徴募・防備を自動強化</span>
      </button>
      <button class="diff-option-btn" id="btnPresetDirect" style="border-color:var(--gold); color:var(--gold-bright); padding:8px;">
        👑 全領国を直轄に戻す<br><span style="font-size: 12pt; color:#ccc;">全て自分で手動指揮</span>
      </button>
    </div>

    <!-- 領国個別・選択一括切替バー -->
    <div style="background:rgba(0,0,0,0.4); border:1px solid #553e2a; border-radius:5px; padding:10px; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
      <div style="display:flex; align-items:center; gap:8px;">
        <label><input type="checkbox" id="selectAllProvsCheckbox" style="accent-color:var(--gold);"> 全選択</label>
        <span style="font-size: 12pt; color:var(--text-muted);">選択中の国に一括適用:</span>
      </div>
      <div style="display:flex; gap:6px;">
        <button class="diff-option-btn" id="applyDirectBatch" style="padding:4px 10px;">👑 直轄</button>
        <button class="diff-option-btn" id="applyMilitaryBatch" style="padding:4px 10px; border-color:#e74c3c; color:#ffaaaa;">⚔️ 軍事</button>
        <button class="diff-option-btn" id="applyDomesticBatch" style="padding:4px 10px; border-color:#27ae60; color:#a9dfbf;">🌾 内政</button>
        <button class="diff-option-btn" id="applyBalancedBatch" style="padding:4px 10px; border-color:#f39c12; color:#f9e79f;">⚖️ 均衡</button>
        <button class="diff-option-btn" id="applyLogisticsBatch" style="padding:4px 10px; border-color:#3498db; color:#aed6f1;">🚚 兵站</button>
      </div>
    </div>

    <!-- 自家領国一覧テーブル -->
    <div style="max-height: 320px; overflow-y: auto; border:1px solid #443322; border-radius:4px; background:rgba(15,10,8,0.7);">
      <table style="width:100%; border-collapse:collapse; font-size: 12pt; text-align:left;">
        <thead>
          <tr style="background:#2b1c14; color:var(--gold-bright); border-bottom:1px solid #553e2a;">
            <th style="padding:8px 10px; width:40px;">選</th>
            <th style="padding:8px 10px;">領国 (本拠城)</th>
            <th style="padding:8px 10px;">位置</th>
            <th style="padding:8px 10px;">駐留兵力</th>
            <th style="padding:8px 10px;">石高/商業</th>
            <th style="padding:8px 10px;">現在の統治方針</th>
          </tr>
        </thead>
        <tbody id="governProvTableBody">
        </tbody>
      </table>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:14px;">
      <button class="turn-btn" id="closeGovernModalBtn" style="margin:0; width:auto; padding:6px 24px; font-size:12pt;">
        統治方針を決定して戻る
      </button>
    </div>
  </div>
</div>

<!-- 3. 出陣侵攻モーダル (隣接国へのみ出陣可能・武将選択は省略) -->
<div class="modal-overlay hidden" id="deployModal">
  <div class="modal-card" style="max-width: 640px;">
    <div class="modal-title" style="color:#ff6666; border-bottom-color:#aa3333;">
      🔥 出陣侵攻 (隣接する敵領国への進撃)
    </div>
    <div style="font-size:12pt; line-height: 1.7; margin-bottom: 12px;">
      出陣元領国: <strong id="deploySrcName" style="color:var(--gold-bright);">土佐 (岡豊城)</strong> (駐留兵: <span id="deployMaxTroops">5,000</span>)<br>
      出陣先敵国: 
      <select id="deployDstSelect" style="background:#201710; color:#fff; border:1px solid #775533; padding:5px 10px; border-radius:4px; font-family:inherit; font-size:12pt;">
      </select>
      <div style="font-size: 12pt; color:var(--text-muted); margin-top:2px;">※街道・航路で直接隣接している敵領にのみ攻め込めます。</div>
      
      <div style="margin-top:10px; background:rgba(0,0,0,0.4); padding:8px 12px; border-radius:4px; border:1px solid #4a3828;">
        <label for="deployTroopRange">出陣兵力: <strong id="deployTroopCount" style="color:var(--gold-bright); font-size:13.5pt;">3,000</strong> 人</label>
        <input type="range" id="deployTroopRange" style="width:100%; margin-top:4px; accent-color:var(--gold);" min="500" step="100">
        <div style="display:flex; justify-content:space-between; font-size: 12pt; color:var(--text-muted); margin-top:3px;">
          <span>城の残留防衛兵: <strong id="deployRemainTroops" style="color:#fff;">2,000</strong> 人</span>
          <span>必要兵糧: <strong id="deployRiceCost" style="color:#ffd700;">150</strong> 石</span>
        </div>
      </div>

      <!-- 出陣陣形選択 -->
      <div style="margin-top:10px;">
        <label style="font-weight:bold; color:var(--gold-bright);">出陣陣形編成：</label>
        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap:6px; margin-top:4px;" id="formationOptionGroup">
          <button class="diff-option-btn selected" data-form="gyorin">魚鱗 (突撃突破)</button>
          <button class="diff-option-btn" data-form="kakuyoku">鶴翼 (包囲殲滅)</button>
          <button class="diff-option-btn" data-form="hoshi">鋒矢 (中央直撃)</button>
          <button class="diff-option-btn" data-form="kuruma">車懸 (波状連撃)</button>
          <button class="diff-option-btn" data-form="hoen">方円 (鉄壁防御)</button>
          <button class="diff-option-btn" data-form="ganko">雁行 (鉄砲斉射)</button>
        </div>
        <div id="formationMatchupHint" style="margin-top:6px; font-size:11pt; color:#cde8ff; background:rgba(30,60,90,0.35); border:1px solid #3a6a9a; border-radius:4px; padding:5px 8px;">
          三すくみ：突撃系 &gt; 包囲系 &gt; 防御系 &gt; 突撃系
        </div>
        <div id="formationIntelBox" style="margin-top:6px; font-size:11.5pt; color:#ffe9a8; background:rgba(80,50,10,0.4); border:1px solid #a67c2a; border-radius:4px; padding:6px 8px;">
          軍師の読み：出陣先を選ぶと敵陣形の予測が表示されます
        </div>
      </div>
    </div>
    <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:10px;">
      <button class="sound-btn" id="deployCancelBtn" style="background:#332218; padding:6px 16px;">軍令中止</button>
      <button class="turn-btn" id="deployConfirmBtn" style="margin:0; width:auto; padding:6px 20px; font-size:12.5pt;">いざ出陣！</button>
    </div>
  </div>
</div>

<!-- 4. 野戦合戦モーダル (一騎討ちは廃止・5大野戦コマンド) -->
<div class="modal-overlay hidden" id="battleModal">
  <div class="modal-card" style="max-width: 760px;">
    <div class="modal-title" style="color:#ff6666; border-bottom-color:#aa3333;" id="battleTitle">
      ⚔️ 野戦決戦
    </div>
    <div class="battle-stage">
      <div class="battle-army-card" id="playerArmyCard">
        <div class="army-header">
          <span style="color:var(--gold-bright);" id="playerArmyClan">我が軍</span>
          <span style="font-size: 12pt; color:#aaa;" id="playerFormationLabel">陣形: 魚鱗</span>
        </div>
        <div style="font-size: 12pt; color:#ddd;" id="playerGeneralName">大将: 長宗我部元親</div>
        <div class="army-troops-bar">
          <div class="army-troops-fill" id="playerArmyBar" style="width:100%;"></div>
          <span class="army-troops-text" id="playerArmyTroopsText">3,000 / 3,000</span>
        </div>
        <div style="display:flex; justify-content:space-between; font-size: 12pt; color:#bbb;">
          <span>士気: <strong id="playerArmyMorale" style="color:#ffd700;">90</strong></span>
          <span>戦術奥義: <strong id="playerArmyTactic" style="color:#8ed8ff;">一領具足の進撃</strong></span>
        </div>
      </div>

      <div class="battle-army-card" id="enemyArmyCard">
        <div class="army-header">
          <span style="color:#ff8888;" id="enemyArmyClan">敵軍</span>
          <span style="font-size: 12pt; color:#aaa;" id="enemyFormationLabel">陣形: 鶴翼</span>
        </div>
        <div style="font-size: 12pt; color:#ddd;" id="enemyGeneralName">大将: 敵軍総大将</div>
        <div class="army-troops-bar">
          <div class="army-troops-fill enemy" id="enemyArmyBar" style="width:100%;"></div>
          <span class="army-troops-text" id="enemyArmyTroopsText">2,500 / 2,500</span>
        </div>
        <div style="display:flex; justify-content:space-between; font-size: 12pt; color:#bbb;">
          <span>士気: <strong id="enemyArmyMorale" style="color:#ffd700;">85</strong></span>
          <span>戦術奥義: <strong id="enemyArmyTactic" style="color:#ff8888;">敵陣突破</strong></span>
        </div>
      </div>
    </div>

    <!-- 合戦行動コマンド (一騎討ち廃止・5コマンド) -->
    <div id="battleFormationBonus" style="margin:6px 0 8px; font-size:11.5pt; color:#ffe9a8; background:rgba(60,30,10,0.45); border:1px solid #a67c2a; border-radius:4px; padding:5px 10px; text-align:center;">
      陣形相性・地形補正
    </div>
    <div class="battle-actions" style="grid-template-columns: repeat(5, 1fr);">
      <button class="battle-btn" id="bCmdAssault">
        <span>🔨 突撃攻勢</span>
        <span class="sub">大打撃/自損有</span>
      </button>
      <button class="battle-btn" id="bCmdShoot">
        <span>🏹 弓砲射撃</span>
        <span class="sub">遠距離安全射</span>
      </button>
      <button class="battle-btn" id="bCmdDefend">
        <span>🛡️ 盾陣防御</span>
        <span class="sub">被害半減反撃</span>
      </button>
      <button class="battle-btn" id="bCmdTactic" style="border-color:var(--gold); color:var(--gold-bright);">
        <span>⚡ 陣形奥義</span>
        <span class="sub">大名固有必殺</span>
      </button>
      <button class="battle-btn" id="bCmdRetreat" style="border-color:#7f8c8d; color:#bdc3c7;">
        <span>🏃 全軍撤退</span>
        <span class="sub">自領へ帰還</span>
      </button>
    </div>

    <div class="battle-log" id="battleLog">
      <div>合戦が開始されました。部隊に軍令を下してください。</div>
    </div>
  </div>
</div>

<!-- 5. 攻城戦モーダル (完全強化・包囲軍残存兵・城内兵・城壁・士気を完全連動) -->
<div class="modal-overlay hidden" id="siegeModal">
  <div class="modal-card" style="max-width: 720px;">
    <div class="modal-title" style="color:#f39c12; border-bottom-color:#d35400;">
      🏯 攻城包囲戦（城郭攻略）
    </div>
    <div class="siege-stage">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
        <span style="font-size:14pt; font-weight:bold; color:var(--gold-bright);" id="siegeCastleName">
          小田原城 包囲戦
        </span>
        <span style="font-size: 12pt; color:#aed6f1;" id="siegePlayerTroopsBadge">
          包囲我が軍: 3,000 人
        </span>
      </div>

      <!-- 我が軍包囲兵力バー -->
      <div style="background:rgba(0,0,0,0.5); padding:8px; border-radius:4px; margin-bottom:8px;">
        <div style="font-size: 12pt; color:#ddd; margin-bottom:3px; display:flex; justify-content:space-between;">
          <span>我が包囲軍残存兵力</span>
          <strong id="siegePlayerTroopsText" style="color:#2ecc71;">3,000 / 3,000</strong>
        </div>
        <div class="fighter-bar-wrap">
          <div class="fighter-bar-fill" id="siegePlayerBar" style="width:100%; background:linear-gradient(90deg, #27ae60, #2ecc71);"></div>
        </div>
      </div>

      <!-- 敵城3大ステータス (城壁、城内兵、城内士気) -->
      <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:8px; margin-bottom:8px;">
        <div style="background:rgba(0,0,0,0.5); padding:8px; border-radius:4px;">
          <div style="font-size: 12pt; color:#ddd; margin-bottom:3px;">城壁耐久度</div>
          <div style="font-size:13pt; font-weight:bold; color:#f1c40f;" id="siegeWallText">100 / 100</div>
          <div class="fighter-bar-wrap" style="margin-top:4px;">
            <div class="fighter-bar-fill" id="siegeWallBar" style="width:100%; background:#f1c40f;"></div>
          </div>
        </div>
        <div style="background:rgba(0,0,0,0.5); padding:8px; border-radius:4px;">
          <div style="font-size: 12pt; color:#ddd; margin-bottom:3px;">城内籠城兵力</div>
          <div style="font-size:13pt; font-weight:bold; color:#e74c3c;" id="siegeEnemyTroopsText">1,500 人</div>
          <div class="fighter-bar-wrap" style="margin-top:4px;">
            <div class="fighter-bar-fill enemy" id="siegeEnemyTroopsBar" style="width:100%; background:#e74c3c;"></div>
          </div>
        </div>
        <div style="background:rgba(0,0,0,0.5); padding:8px; border-radius:4px;">
          <div style="font-size: 12pt; color:#ddd; margin-bottom:3px;">城内兵糧・士気</div>
          <div style="font-size:13pt; font-weight:bold; color:#e67e22;" id="siegeMoraleText">80</div>
          <div class="fighter-bar-wrap" style="margin-top:4px;">
            <div class="fighter-bar-fill" id="siegeMoraleBar" style="width:80%; background:#e67e22;"></div>
          </div>
        </div>
      </div>

      <!-- 攻城年代記ログ -->
      <div class="battle-log" id="siegeLog" style="height:75px; margin-bottom:8px;">
        <div>城を完全に包囲しました。攻城作戦を選択してください。</div>
      </div>

      <!-- 攻城作戦ボタン ＆ 撤退ボタン -->
      <div style="display:grid; grid-template-columns: repeat(5, 1fr); gap:6px;">
        <button class="battle-btn" id="siegeBtnAssault" style="border-color:#e74c3c;">
          <span>🔨 強襲力攻め</span>
          <span class="sub">城壁大破壊/自損小</span>
        </button>
        <button class="battle-btn" id="siegeBtnShoot" style="border-color:#e67e22;">
          <span>🏹 矢砲斉射</span>
          <span class="sub">城内兵削り/自損無</span>
        </button>
        <button class="battle-btn" id="siegeBtnSurround" style="border-color:#3498db;">
          <span>🌾 兵糧遮断</span>
          <span class="sub">城内士気大幅削り</span>
        </button>
        <button class="battle-btn" id="siegeBtnPersuade" style="border-color:var(--gold);">
          <span>📜 開城勧告</span>
          <span class="sub">無血開城・降伏促す</span>
        </button>
        <button class="battle-btn" id="siegeBtnRetreat" style="border-color:#7f8c8d; color:#bdc3c7;">
          <span>🏃 包囲解除</span>
          <span class="sub">攻城中断し帰還</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- 6. 兵力移動モーダル (配置転換) -->
<div class="modal-overlay hidden" id="transferModal">
  <div class="modal-card" style="max-width: 480px;">
    <div class="modal-title">兵力再配置 (配置転換)</div>
    <div style="font-size:12pt; line-height: 1.7; margin-bottom: 12px;">
      移動元: <strong id="transferSrcName" style="color:var(--gold-bright);">尾張</strong> (駐留兵: <span id="transferMaxTroops">0</span>)<br>
      移動先: 
      <select id="transferDstSelect" style="background:#201710; color:#fff; border:1px solid #775533; padding:5px 10px; border-radius:4px; font-family:inherit; font-size:12pt;">
      </select>
      <div style="margin-top:10px; background:rgba(0,0,0,0.4); padding:8px; border-radius:4px;">
        <label for="transferTroopRange">移動兵力: <strong id="transferTroopCount" style="color:var(--gold-bright); font-size:13.5pt;">0</strong> 人</label>
        <input type="range" id="transferTroopRange" style="width:100%; margin-top:4px; accent-color:var(--gold);" min="100" step="100">
        <div style="font-size: 12pt; color:var(--text-muted); margin-top:4px;">
          残留防衛兵: <span id="transferRemainTroops" style="color:#fff;">0</span> 人
        </div>
      </div>
    </div>
    <div style="display:flex; justify-content:flex-end; gap:10px;">
      <button class="sound-btn" id="transferCancelBtn" style="background:#332218; padding:6px 16px;">中止</button>
      <button class="turn-btn" id="transferConfirmBtn" style="margin:0; width:auto; padding:6px 20px; font-size:12.5pt;">移動発令</button>
    </div>
  </div>
</div>

<!-- 6.5. 征夷大将軍宣下モーダル (30か国・京洛領有) -->
<div class="modal-overlay hidden" id="shogunModal" style="z-index: 9998;">
  <div class="modal-card" style="max-width: 760px; text-align: center; border-color: #ffd700; box-shadow: 0 0 70px rgba(255,215,0,0.85); background: linear-gradient(180deg, #24160e 0%, #150d08 100%);">
    <div class="modal-title" style="color: #ffd700; font-size: 22pt; border-bottom: 2px solid #ffd700; padding-bottom: 10px;">
      👑 勅許・征夷大将軍宣下 👑
    </div>
    <div style="font-size: 16pt; font-weight: bold; color: #fff; margin: 16px 0 8px 0;" id="shogunDaimyoName">
      当主 公
    </div>
    <div style="font-size: 12pt; color: #ffdd88; margin-bottom: 16px;">
      京洛・山城国を掌握し、全国過半（四拾州以上）を席捲せし武門の棟梁
    </div>
    <div style="background: rgba(0,0,0,0.55); border: 1px solid #775533; border-radius: 6px; padding: 18px 24px; margin-bottom: 20px; font-size: 12pt; line-height: 1.9; color: #f2e6d5; text-align: left;">
      <p style="margin: 0; text-indent: 1em;">
        朝廷より勅使が下向し、天下の静謐を成し遂げし貴家に対し、正二位・征夷大将軍の官位宣下が下されました！<br>
        ここに武門の頂点たる新幕府を開き、万民安穏の泰平の世を築くか、あるいは残る諸勢力をことごとく平定し、全六拾九州完全統一の覇道を邁進するか、御下問にございます。
      </p>
    </div>
    <div style="display:flex; justify-content:center; gap:14px; margin-top:10px;">
      <button class="turn-btn" id="shogunAcceptEndingBtn" style="margin: 0; max-width: 320px; font-size: 12pt; padding: 10px 22px; background: linear-gradient(180deg, #d4af37, #9a7b2c); color:#111; font-weight:bold;">
        📜 宣下を受諾し幕府開府（将軍エンディング）
      </button>
      <button class="turn-btn" id="shogunContinueConquestBtn" style="margin: 0; max-width: 280px; font-size: 12pt; padding: 10px 22px;">
        ⚔️ 覇道を貫き全土完全統一へ
      </button>
    </div>
  </div>
</div>

<!-- 6.5. 感動の全画面シネマティック・エンドロールシアター -->
<div class="modal-overlay hidden" id="endingRollModal" style="position:fixed; inset:0; width:100vw; height:100vh; background:#070403; z-index:99999; display:flex; flex-direction:column; overflow:hidden;">
  <!-- 桜吹雪キャンバス -->
  <canvas id="endingSakuraCanvas" style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none; z-index:2;"></canvas>

  <!-- 背景大名家紋透かし -->
  <div id="endingKamonBackdrop" style="position:absolute; inset:0; display:flex; align-items:center; justify-content:center; opacity:0.12; pointer-events:none; z-index:1;"></div>

  <!-- 操作コントロールバー (右上固定) -->
  <div style="position:absolute; top:20px; right:28px; z-index:10; display:flex; gap:10px; align-items:center;">
    <button id="endingPauseBtn" style="background:rgba(20,12,8,0.85); color:#ffd700; border:1px solid #8c734b; border-radius:20px; padding:6px 16px; font-size:11.5pt; font-family:inherit; cursor:pointer; box-shadow:0 0 10px rgba(0,0,0,0.8); transition:all 0.2s;">
      ⏸ 一時停止
    </button>
    <button id="endingSpeedBtn" style="background:rgba(20,12,8,0.85); color:#ffd700; border:1px solid #8c734b; border-radius:20px; padding:6px 16px; font-size:11.5pt; font-family:inherit; cursor:pointer; box-shadow:0 0 10px rgba(0,0,0,0.8); transition:all 0.2s;">
      ⏩ 速度: 1.0x
    </button>
    <button id="endingSkipBtn" style="background:linear-gradient(180deg, #d4af37, #8c6d23); color:#111; border:1px solid #fff; border-radius:20px; padding:6px 18px; font-size:11.5pt; font-weight:bold; font-family:inherit; cursor:pointer; box-shadow:0 0 15px rgba(212,175,55,0.6); transition:all 0.2s;">
      ⏭ スキップして統一記録へ
    </button>
  </div>

  <!-- スクロールコンテナ -->
  <div id="endingRollContainer" style="position:absolute; inset:0; overflow-y:scroll; scroll-behavior:auto; z-index:3; text-align:center; padding: 45vh 20px 45vh 20px; box-sizing:border-box;">
    <div id="endingRollContent" style="max-width:860px; margin:0 auto; color:#fff; text-shadow:0 2px 10px rgba(0,0,0,0.95); font-family:'Noto Serif JP', 'Yu Mincho', serif;">
      <!-- JavaScriptにより各大名家・ルート固有のエンドロールが動的生成されます -->
    </div>
  </div>
</div>

<!-- 7. 天下統一偉業達成モーダル -->
<div class="modal-overlay hidden" id="victoryModal" style="z-index: 9999;">
  <div class="modal-card" style="max-width: 1420px; width: 92vw; max-height: 92vh; display: flex; flex-direction: column; text-align: center; border-color: #ffd700; box-shadow: 0 0 70px rgba(255,215,0,0.85); padding: 20px 32px; box-sizing: border-box;">
    <div style="flex-shrink: 0; border-bottom: 2px solid #ffd700; padding-bottom: 8px; margin-bottom: 10px;">
      <div class="modal-title" style="color: #ffd700; font-size: 22pt; margin-bottom: 4px;" id="victoryMainTitle">
        ❖ 天下統一の偉業達成 ❖
      </div>
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 4px;">
        <span style="font-size: 13pt; color: #d4af37;" id="victorySubTitle">【朝廷勅命・天下静謐の武門棟梁】</span>
        <span style="font-size: 18pt; font-weight: bold; color: #fff;" id="victoryDaimyoName">長宗我部元親</span>
        <span style="font-size: 12.5pt; color: var(--gold-bright);" id="victoryStatsSummary">天文20年 春 〜 永禄10年 秋 (所要18年・48戦無敗)</span>
      </div>
    </div>
    
    <div style="flex: 1 1 auto; min-height: 0; background: rgba(0,0,0,0.65); border: 1px solid #665533; border-radius: 8px; padding: 16px 22px; margin-bottom: 12px; font-size: 12pt; line-height: 1.8; color: #f2e6d5; text-align: left; overflow-y: auto;" id="victoryChronicleText">
    </div>

    <div style="flex-shrink: 0; display:flex; justify-content:center; gap:16px; margin-top: 2px;">
      <button class="turn-btn" id="victoryWatchRollBtn" style="margin: 0; min-width: 280px; font-size: 13pt; padding: 10px 28px; background:linear-gradient(180deg, #d4af37, #8c6d23); color:#111; font-weight:bold; box-shadow: 0 4px 15px rgba(212,175,55,0.4);">
        📜 エンドロールをもう一度観る
      </button>
      <button class="turn-btn" id="victoryRestartBtn" style="margin: 0; min-width: 240px; font-size: 13pt; padding: 10px 28px;">
        🔄 新たなる覇道へ
      </button>
    </div>
  </div>
</div>

<!-- 8. シナリオ開始前・時代背景＆勢力紹介解説モーダル -->
<div class="modal-overlay hidden" id="scenarioIntroModal">
  <div class="modal-card" style="max-width: 860px; border-color: var(--gold-bright); box-shadow: 0 0 50px rgba(212,175,55,0.7);">
    <div class="modal-title" id="introModalTitle" style="color:var(--gold-bright); font-size:16pt; text-align:center;">
      ❖ 時代背景 ＆ 天下情勢解説 ❖
    </div>
    
    <div style="background:rgba(0,0,0,0.5); border:1px solid var(--border-gold); border-radius:6px; padding:14px 18px; margin-bottom:12px; max-height:420px; overflow-y:auto; line-height:1.7;">
      <!-- 時代背景 -->
      <div style="margin-bottom:12px;">
        <div style="font-weight:bold; font-size:12pt; color:#ffd700; border-bottom:1px solid #665533; padding-bottom:3px; margin-bottom:6px;">
          📖 【時代背景・歴史の奔流】
        </div>
        <div id="introBackgroundText" style="font-size: 12pt; color:#f0e6d6; text-indent:1em;">
        </div>
      </div>

      <!-- 主要勢力紹介 -->
      <div style="margin-bottom:12px;">
        <div style="font-weight:bold; font-size:12pt; color:#ffd700; border-bottom:1px solid #665533; padding-bottom:3px; margin-bottom:6px;">
          ⚔️ 【主要勢力図・群雄の陣営】
        </div>
        <div id="introFactionsText" style="font-size: 12pt; color:#e0d0b0; white-space:pre-wrap; background:rgba(0,0,0,0.3); padding:8px 12px; border-radius:4px;">
        </div>
      </div>

      <!-- 覇道の焦点 -->
      <div style="margin-bottom:12px;">
        <div style="font-weight:bold; font-size:12pt; color:#ffd700; border-bottom:1px solid #665533; padding-bottom:3px; margin-bottom:6px;">
          🎯 【覇道の焦点・戦略の要衝】
        </div>
        <div id="introFocusText" style="font-size: 12pt; color:#ffdd88;">
        </div>
      </div>

      <!-- 大名出陣宣誓 -->
      <div style="background:rgba(50,25,15,0.8); border:1px dashed #ffd700; border-radius:5px; padding:10px 14px;">
        <div id="introDaimyoOath" style="font-size: 12pt; color:#fff; font-weight:bold; text-align:center;">
        </div>
      </div>
    </div>

    <div style="text-align:center;">
      <button class="turn-btn" id="introStartBtn" style="max-width:320px; margin:0 auto; padding:8px 24px; font-size:13pt; background:linear-gradient(180deg, #d4af37, #9a7b2c); color:#111; font-weight:bold;">
        承知！ いざ天下統一へ出陣！
      </button>
    </div>
  </div>
</div>

