    <circle cx="16" cy="16" r="15" fill="#1b4f72" stroke="#ffd700" stroke-width="1.5"/>
    <circle cx="16" cy="16" r="12" fill="none" stroke="#ffd700" stroke-width="1.2"/>
    <!-- 明智水色桔梗紋 -->
    <polygon points="16,6 18.5,13 25,12 20,17 22.5,24 16,20 9.5,24 12,17 7,12 13.5,13" fill="#ffffff"/>
    <circle cx="16" cy="16" r="2.5" fill="#1b4f72"/>
  </symbol>
</defs>

        <g id="mapPanZoomLayer">
          <!-- 街道・航路接続線グループ -->
          <g id="mapRoadsGroup"></g>
          <!-- 50領国ポリゴングループ -->
          <g id="mapProvincesGroup"></g>
          <!-- 大名家紋バッジグループ -->
          <g id="mapMarkersGroup"></g>
        </g>
      </svg>
      
      <!-- 地図注記と表示モード切替（注記の右隣に並べる） -->
      <div class="map-overlay-bar" id="mapOverlayBar">
        <div class="map-legend">
          <!-- PC向けの操作説明 -->
          <span class="legend-desktop">❖ <strong>ドラッグで移動</strong> ／ <strong>ホイールで拡大縮小</strong>可能。<br></span>
          <!-- スマホ向けの操作説明（768px以下でのみ表示） -->
          <span class="legend-mobile">❖ <strong>指で上下左右に移動</strong> ／ <strong>2本指または＋−で拡大</strong>。<br></span>
          【金枠】：選択領地 ／ <strong>隣接する国にのみ出陣・侵攻</strong>できます。
        </div>
        <div class="map-heat-panel" id="mapHeatPanel" title="地図表示モード">
          <div class="map-heat-filter" id="mapHeatFilter">
            <button type="button" class="map-heat-btn active" data-heat="owner" title="領国色">領国</button>
            <button type="button" class="map-heat-btn" data-heat="diplomacy" title="外交関係">外交</button>
            <button type="button" class="map-heat-btn" data-heat="troops" title="兵力ヒートマップ">兵力</button>
            <button type="button" class="map-heat-btn" data-heat="rice" title="石高ヒートマップ">石高</button>
          </div>
          <div class="map-heat-legend" id="mapHeatLegend"><span class="heat-note">各大名家の領国色</span></div>
        </div>
      </div>
    </div>

    <!-- 右側：領地軍情 & 指令コマンド -->
    <div class="side-panel">
      <!-- 領地詳細情報 ＆ 統治方針設定 -->
      <div class="panel-box prov-panel">
        <div class="panel-title">
          <span>領国軍情</span>
          <span id="selectedProvBadge" style="font-size: 12pt; color:var(--gold);">選択なし</span>
        </div>
        <div class="province-detail" id="provDetailBox">
          <p style="color:var(--text-muted); text-align:center; padding: 10px 0; font-size: 12pt;">
            地図上の領国をクリックしてください
          </p>
        </div>
      </div>

      <!-- 厳選4大コマンドパネル (直感的で迷わない少数精鋭) -->
      <div class="panel-box cmd-panel">
        <div class="panel-title">
          <span>軍令発令所</span>
          <span style="font-size: 12pt; color:var(--gold-bright);" id="actionCountLabel">令状消費: 各1</span>
        </div>

        <div class="commands-grid" style="grid-template-columns: 1fr; gap: 4px; margin-top: 4px;">
          <!-- 1. 最重要：出陣侵攻 -->
          <button class="cmd-btn" id="cmdAttack" disabled style="border-color:#c0392b; background:linear-gradient(135deg, rgba(192,57,43,0.35), rgba(0,0,0,0.5)); padding:4px 10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-bottom:1px;">
              <span style="font-size:11.5pt; font-weight:bold; color:#ffaaaa;">🔥 出陣侵攻 (隣接敵国へ進撃)</span>
              <span class="cost" style="font-size:10.5pt; color:#ffd700; font-weight:bold;">出陣兵糧消費</span>
            </div>
            <div style="font-size:10pt; color:#ddd; text-align:left; width:100%; line-height:1.15;">
              出陣兵力に応じた兵糧消費 ｜ 敵城へ決戦進撃！
            </div>
          </button>

          <!-- 2. 内政振興 -->
          <button class="cmd-btn" id="cmdDomestic" disabled style="border-color:#27ae60; padding:4px 10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-bottom:1px;">
              <span style="font-size:11.5pt; font-weight:bold; color:#a9dfbf;">🌾 内政振興 (新田開墾・商業)</span>
              <span class="cost" style="font-size:10.5pt; color:#ccc;">金50 (糧なし)</span>
            </div>
            <div style="font-size:10pt; color:#ccc; text-align:left; width:100%; line-height:1.15;">
              石高+20〜28, 商業+20〜28 (当主内政力依存)
            </div>
          </button>

          <!-- 3. 軍備増強 -->
          <button class="cmd-btn" id="cmdMilitary" disabled style="border-color:#2980b9; padding:4px 10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-bottom:1px;">
              <span style="font-size:11.5pt; font-weight:bold; color:#aed6f1;">⚔️ 軍備増強 (徴兵・士気・城普請)</span>
              <span class="cost" style="font-size:10.5pt; color:#ccc;">金40 (糧なし)</span>
            </div>
            <div style="font-size:10pt; color:#ccc; text-align:left; width:100%; line-height:1.15;">
              兵力+300〜500, 士気+, 城防+8 (当主武勇依存)
            </div>
          </button>

          <!-- 4. 敵国調略 -->
          <button class="cmd-btn" id="cmdStratagem" disabled style="border-color:#8e44ad; padding:4px 10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-bottom:1px;">
              <span style="font-size:11.5pt; font-weight:bold; color:#d7bde2;">🗡️ 敵国調略 (流言・放火・工作)</span>
              <span class="cost" style="font-size:10.5pt; color:#ccc;">金40 (糧なし)</span>
            </div>
            <div style="font-size:10pt; color:#ccc; text-align:left; width:100%; line-height:1.15;">
              敵士気-15〜22, 城防-12〜18 (当主知略依存)
            </div>
          </button>

          <!-- 5. 人材登用 (浪人招聘) -->
          <button class="cmd-btn" id="cmdRecruit" disabled style="border-color:var(--gold-bright); background:linear-gradient(135deg, rgba(212,175,55,0.18), rgba(0,0,0,0.5)); padding:4px 10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%; margin-bottom:1px;">
              <span style="font-size:11.5pt; font-weight:bold; color:var(--gold-bright);">🤝 人材登用 (浪人招聘・仕官)</span>
              <span class="cost" style="font-size:10.5pt; color:#ffd700; font-weight:bold;">金40 (令状1)</span>
            </div>
            <div style="font-size:10pt; color:#ccc; text-align:left; width:100%; line-height:1.15;">
              各地の浪人を捜索・招聘し配下武将に加える
            </div>
          </button>

          <!-- 補助：兵力再配置 -->
          <button class="cmd-btn" id="cmdTransfer" disabled style="border-color:#555; padding:4px 10px;">
            <div style="display:flex; justify-content:space-between; align-items:center; width:100%;">
              <span style="font-size:11pt; font-weight:bold;">🚚 前線兵力移動</span>
              <span style="font-size:10pt; color:#aaa;">自領国間での兵力再配置</span>
            </div>
          </button>
        </div>

        <button class="turn-btn" id="nextTurnBtn" style="margin-top:5px; padding:6px 14px; font-size:12.5pt;">
          <span>⚔️ 季節を進める (軍令権回復・次期へ)</span>
        </button>

        <!-- オートプレーモード設定パネル (上下圧縮・半分以下) -->
        <div class="autoplay-panel" id="autoPlayPanel" title="仕官の申し出は自動承諾。歴史イベントは発生時に一時停止し、選択後に再開します">
          <div class="autoplay-header">
            <div class="autoplay-title">
              <span class="autoplay-indicator" id="autoPlayIndicator"></span>
              <span class="autoplay-label" id="autoPlayLabel">⏩ 季節オート進行</span>
              <span style="font-size:9pt; color:#c8b896; cursor:help;" title="仕官の申し出は自動承諾。歴史イベントは発生時に一時停止し、選択後に再開します">ℹ️</span>
            </div>
            <button type="button" class="autoplay-toggle-btn" id="autoPlayToggleBtn">
              <span id="autoPlayBtnIcon">▶</span>
              <span id="autoPlayBtnText">開始</span>
            </button>
          </div>
          <div class="autoplay-speed-row">
            <span class="autoplay-speed-title">進行速度:</span>
            <input type="range" class="autoplay-slider" id="autoPlaySpeedSlider" min="0.1" max="3.0" step="0.1" value="0.5">
            <span class="autoplay-speed-val" id="autoPlaySpeedVal">0.5秒</span>
          </div>
        </div>
      </div>


    </div>
  </div>
</div>

<!-- ============================================== -->
<!-- モーダル群 (すべて12ptで読みやすく平易に設計) -->
<!-- ============================================== -->

<!-- 1. ゲーム開始・シナリオ＆大名家選択モーダル (全42大歴史シナリオ) -->
<!-- マウスオーバー（ホバー）時の発光エフェクト -->
<style>
  .scenario-btn {
    transition: all 0.2s ease; /* ふわっと光るアニメーション */
  }
  .scenario-btn:hover {
    border-color: #ffd700 !important;
    background: rgba(212, 175, 55, 0.15) !important;
    box-shadow: 0 0 8px rgba(255, 215, 0, 0.5);
  }
  .diff-option-btn {
    transition: all 0.2s ease;
  }
  .diff-option-btn:hover {
    border-color: #ffd700 !important;
    background: rgba(255, 255, 255, 0.1) !important;
  }
</style>

<!-- 1. ゲーム開始・シナリオ＆大名家選択モーダル (全53大歴史シナリオ・年代順網羅) -->
<div class="modal-overlay" id="startModal">
  <div class="modal-card" style="width: 96vw; max-width: 1760px; max-height: 94vh; padding: 16px 24px; box-sizing: border-box;">
    <div class="modal-title" style="font-size: 16pt; font-weight: bold; text-align: center; color: var(--gold-bright); margin-bottom: 12px;">❖ 歴史シナリオ ＆ 戦国大名家 選択 ❖</div>

    <!-- 自動セーブ再開バナー -->
    <div id="resumeSaveBanner" style="display:none; background:linear-gradient(90deg, rgba(27,79,114,0.9), rgba(41,128,185,0.9)); border:2px solid #5dade2; border-radius:6px; padding:6px 16px; margin-bottom:8px; align-items:center; justify-content:space-between; box-shadow:0 0 15px rgba(93,173,226,0.4);">
      <div>
        <span style="font-weight:bold; font-size:12pt; color:#fff;">🔁 自動保存された前回の戦況記録があります</span>
        <div style="font-size: 12pt; color:#d4e6f1;" id="resumeSaveSummary">1565年 秋 / 長宗我部家 (支配: 8国)</div>
      </div>
      <button class="turn-btn" id="resumeSaveBtn" style="margin:0; width:auto; padding:4px 20px; font-size:12pt; background:linear-gradient(180deg, #27ae60, #1e8449); border-color:#2ecc71;">
        前回の戦況から再開
      </button>
    </div>

    <div style="text-align:center; font-size: 12pt; color:var(--text-muted); margin-bottom:8px;">
      時代と覇業を率いる大名家を選択してください。選択したシナリオに応じて領国支配図・兵力・情勢・選択可能大名が劇的に変化します。
    </div>

    <!-- 歴史シナリオ選択セレクター (全53大動乱・年代順完全網羅) -->
    <div style="margin-bottom: 6px;">
      <div style="font-size: 12pt; font-weight:bold; color:var(--gold-bright); margin-bottom:4px; display:flex; justify-content:space-between; align-items:center;">
        <span>📜 歴史シナリオ選択 (全53大動乱・東北征討から西南戦争まで)</span>
        <span style="font-size: 12pt; color:#ffdd88;">全領国各大名プレイ可能</span>
      </div>

      <!-- 時代別クイック切替タブ -->
      <div class="scenario-era-tabs" id="scenarioEraTabs">
        <button class="era-tab-btn active" data-era="all">❖ すべて (全52動乱)</button>
        <button class="era-tab-btn" data-era="ancient_medieval">古代・中世 (801〜1391)</button>
        <button class="era-tab-btn" data-era="sengoku_early">戦国黎明 (1400〜1546)</button>
        <button class="era-tab-btn" data-era="sengoku_climax">戦国乱世 (1555〜1577)</button>
        <button class="era-tab-btn" data-era="unification">天下統一 (1582〜1614)</button>
        <button class="era-tab-btn" data-era="edo_bakumatsu">泰平・幕末 (1637〜1877)</button>
      </div>

      <!-- 全52シナリオ年代順スクロールグリッド -->
      <div class="scenario-selector-container">
        <div class="scenario-selector-group" id="scenarioSelectorGroup">
